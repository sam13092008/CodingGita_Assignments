    height: 65px;
    object-fit: cover;
}

.song-info h4 {
    font-size: 15px;
    margin-bottom: 4px;
}

.song-info p {
    font-size: 12px;
    color: #aaaaaa;
}

.song-info .heart {
    width: 22px;
    height: 22px;
    object-fit: contain;
    margin-left: 5px;
}

.player-controls {
    width: 38%;
    text-align: center;
}

.player-controls > img {
    width: 220px;
    height: 40px;
    object-fit: contain;
    margin-bottom: 8px;
}

.progress {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    color: #aaaaaa;
}

.progress-line {
    height: 5px;
    background-color: #555555;
    border-radius: 5px;
    flex: 1;
}

.progress-fill {
    width: 80%;
    height: 5px;
    background-color: #b3b3b3;
    border-radius: 5px;
}

.player-options {
    width: 28%;
    text-align: right;
}

.player-options img {
    width: 280px;
    max-width: 100%;
    height: 35px;
    object-fit: contain;
}

.status-bar {
    height: 28px;
    background-color: #1ed760;
    color: black;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    padding: 0 35px;
}

.status-bar p {
    font-size: 14px;
    font-weight: bold;
}
