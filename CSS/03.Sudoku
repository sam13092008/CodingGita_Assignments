<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sudoku Puzzle</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: #f0f2f5;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .sudoku-container {
            background-color: #ffffff;
            padding: 24px;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
        }

        h1 {
            font-size: 24px;
            color: #333333;
            font-weight: 600;
        }

        .sudoku-grid {
            display: grid;
            grid-template-columns: repeat(9, 45px);
            grid-template-rows: repeat(9, 45px);
            border: 3px solid #2c3e50;
            background-color: #2c3e50;
            gap: 1px; 
        }

        .cell {
            background-color: #ffffff;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 20px;
            font-weight: 500;
            color: #2c3e50;
            outline: none;
            border: none;
            text-align: center;
        }

        .cell.given {
            font-weight: 700;
            color: #1a252f;
            background-color: #fdfdfd;
        }

        .cell:not(.given):hover {
            background-color: #edf2f7;
        }

        .cell:not(.given):focus {
            background-color: #e2e8f0;
            box-shadow: inset 0 0 0 2px #3498db;
            z-index: 2;
        }

        .cell:nth-child(9n+3),
        .cell:nth-child(9n+6) {
            border-right: 3px solid #2c3e50;
        }

        .cell:nth-child(n+19):nth-child(-n+27),
        .cell:nth-child(n+46):nth-child(-n+54) {
            border-bottom: 3px solid #2c3e50;
        }
    </style>
</head>
<body>

    <div class="sudoku-container">
        <h1>Sudoku</h1>

        <div class="sudoku-grid">
            <input class="cell given" type="text" maxlength="1" value="5" readonly>
            <input class="cell given" type="text" maxlength="1" value="3" readonly>
            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">
            <input class="cell given" type="text" maxlength="1" value="7" readonly>
            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">

            <input class="cell given" type="text" maxlength="1" value="6" readonly>
            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">
            <input class="cell given" type="text" maxlength="1" value="1" readonly>
            <input class="cell given" type="text" maxlength="1" value="9" readonly>
            <input class="cell given" type="text" maxlength="1" value="5" readonly>
            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">

            <input class="cell" type="text" maxlength="1">
            <input class="cell given" type="text" maxlength="1" value="9" readonly>
            <input class="cell given" type="text" maxlength="1" value="8" readonly>
            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">
            <input class="cell given" type="text" maxlength="1" value="6" readonly>
            <input class="cell" type="text" maxlength="1">

            <input class="cell given" type="text" maxlength="1" value="8" readonly>
            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">
            <input class="cell given" type="text" maxlength="1" value="6" readonly>
            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">
            <input class="cell given" type="text" maxlength="1" value="3" readonly>

            <input class="cell given" type="text" maxlength="1" value="4" readonly>
            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">
            <input class="cell given" type="text" maxlength="1" value="8" readonly>
            <input class="cell" type="text" maxlength="1">
            <input class="cell given" type="text" maxlength="1" value="3" readonly>
            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">
            <input class="cell given" type="text" maxlength="1" value="1" readonly>

            <input class="cell given" type="text" maxlength="1" value="7" readonly>
            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">
            <input class="cell given" type="text" maxlength="1" value="2" readonly>
            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">
            <input class="cell given" type="text" maxlength="1" value="6" readonly>

            <input class="cell" type="text" maxlength="1">
            <input class="cell given" type="text" maxlength="1" value="6" readonly>
            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">
            <input class="cell given" type="text" maxlength="1" value="2" readonly>
            <input class="cell given" type="text" maxlength="1" value="8" readonly>
            <input class="cell" type="text" maxlength="1">

            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">
            <input class="cell given" type="text" maxlength="1" value="4" readonly>
            <input class="cell given" type="text" maxlength="1" value="1" readonly>
            <input class="cell given" type="text" maxlength="1" value="9" readonly>
            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">
            <input class="cell given" type="text" maxlength="1" value="5" readonly>

            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">
            <input class="cell given" type="text" maxlength="1" value="8" readonly>
            <input class="cell" type="text" maxlength="1">
            <input class="cell" type="text" maxlength="1">
            <input class="cell given" type="text" maxlength="1" value="7" readonly>
            <input class="cell given" type="text" maxlength="1" value="9" readonly>
        </div>
    </div>

</body>
</html>
