<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Netflix Clone</title>
    <style>
        * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background-color: #141414;
    color: white;
    font-family: Arial, sans-serif;
}

.navbar {
    display: flex;
    align-items: center;
    padding: 12px 45px;
    position: absolute;
    width: 100%;
    z-index: 1;
}

.logo img {
    width: 90px;
}

.nav-links {
    display: flex;
    gap: 15px;
    margin-left: 20px;
}

.nav-links a {
    text-decoration: none;
    color: white;
    font-size: 12px;
}

.nav-icons {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-left: auto;
}

.nav-icons img {
    width: 18px;
    height: 20px;
    object-fit: contain;
}

.nav-icons img:nth-child(4) {
    width: 24px;
}

.hero {
    height: 540px;
    width: 100%;
    background-image: url("assets/Title-Image.png");
    background-size: cover;
    background-position: center;
    position: relative;
}

.hero-content {
    position: absolute;
    left: 45px;
    bottom: 85px;
}

.show-name {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-bottom: 8px;
}

.show-name img {
    width: 13px;
}

.show-name span {
    font-size: 12px;
    letter-spacing: 2px;
    font-weight: bold;
}

.hero-content h1 {
    font-size: 100px;
    letter-spacing: 3px;
    margin-bottom: 8px;
}

.hero-buttons {
    display: flex;
    gap: 10px;
}

.hero-buttons button {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 8px 15px;
    border: none;
    border-radius: 4px;
    background-color: white;
    font-weight: bold;
    font-size: 13px;
}

.hero-buttons button img {
    width: 15px;
    height: 15px;
    object-fit: contain;
}

.hero-buttons .more-button {
    background-color: #777777;
    color: white;
}

.add-button {
    position: absolute;
    right: 15px;
    bottom: 45px;
}

.add-button img {
    width: 22px;
}

main {
    padding: 0 45px;
    margin-top: -35px;
    position: relative;
}

.movie-section {
    margin-bottom: 40px;
}

.movie-section h3 {
    font-size: 14px;
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    gap: 7px;
}

.movie-section h3 img {
    width: 12px;
    height: 12px;
}

.movie-list {
    display: flex;
    gap: 12px;
    overflow-x: auto;
}

.movie-list img {
    width: 19%;
    height: 106px;
    object-fit: cover;
    border-radius: 4px;
    flex-shrink: 0;
}

.top-ten-list {
    display: flex;
    gap: 12px;
    overflow-x: auto;
}

.top-ten-list img {
    width: 19%;
    height: 145px;
    object-fit: contain;
    flex-shrink: 0;
}

footer {
    padding: 10px 18%;
    margin-top: 45px;
    color: #777777;
}

.social-icons {
    display: flex;
    gap: 15px;
    margin-bottom: 25px;
}

.social-icons img {
    width: 18px;
    height: 18px;
    object-fit: contain;
}

.footer-links {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 25px;
}

.footer-links p {
    font-size: 10px;
    margin-bottom: 15px;
}

.service-button {
    background-color: transparent;
    border: 1px solid #777777;
    color: #777777;
    padding: 8px 12px;
    font-size: 10px;
    margin-bottom: 15px;
}

.copyright {
    font-size: 9px;
}
    </style>
</head>
<body>
    <header>
        <div class="navbar">
            <div class="logo">
                <img src="assets/NetflixLogoSvg.png" alt="Netflix">
            </div>
            <div class="nav-links">
                <a href="#">Start</a>
                <a href="#">Shows</a>
                <a href="#">Movies</a>
                <a href="#">New</a>
                <a href="#">My List</a>
            </div>
            <div class="nav-icons">
                <img src="assets/Search.png" alt="Search">
                <img src="assets/GiftBox.png" alt="Gift">
                <img src="assets/NotificationBell.png" alt="Notifications">
                <img src="assets/ProfileIMG.png" alt="Profile">
                <img src="assets/DownArrow.png" alt="More">
            </div>
        </div>
    </header>
    <section class="hero">
        <div class="hero-content">
            <div class="show-name">
                <img src="assets/Netflix_Symbol_RGB 1.png" alt="N">
                <span>SHOW</span>
            </div>
            <h1>MAID</h1>
            <div class="hero-buttons">
                <button>
                    <img src="assets/Play.png" alt="">
                    Play
                </button>
                <button class="more-button">
                    <img src="assets/Detail.png" alt="">
                    More info
                </button>
            </div>
        </div>
        <div class="add-button">
            <img src="assets/Add.png" alt="Add">
        </div>
    </section>
    <main>
        <section class="movie-section">
            <h3>See again
                <img src="assets/ArrowRight.png" alt="">
            </h3>
            <div class="movie-list">
                <img src="assets/section 1.1.png" alt="Movie">
                <img src="assets/section 1.2.png" alt="Movie">
                <img src="assets/section 1.3.png" alt="Movie">
                <img src="assets/section 1.4.png" alt="Movie">
                <img src="assets/section 1.5.png" alt="Movie">
            </div>
        </section>
        <section class="movie-section">
            <h3>Top 10 in your country
                <img src="assets/ArrowRight.png" alt="">
            </h3>
            <div class="top-ten-list">
                <img src="assets/Rank - 01.png" alt="Number 1">
                <img src="assets/Rank - 02.png" alt="Number 2">
                <img src="assets/Rank - 03.png" alt="Number 3">
                <img src="assets/Rank - 04.png" alt="Number 4">
                <img src="assets/Rank - 05.png" alt="Number 5">
                <img src="assets/Rank - 06.png" alt="Number 6">
            </div>
        </section>
        <section class="movie-section">
            <h3>Trending now
                <img src="assets/ArrowRight.png" alt="">
            </h3>
            <div class="movie-list">
                <img src="assets/section 2.1.png" alt="Trending show">
                <img src="assets/section 2.2.png" alt="Trending show">
                <img src="assets/section 2.3.png" alt="Trending show">
                <img src="assets/section 2.4.png" alt="Trending show">
                <img src="assets/section 2.5.png" alt="Trending show">
            </div>
        </section>
        <section class="movie-section">
            <h3>Sci-fi shows
                <img src="assets/ArrowRight.png" alt="">
            </h3>
            <div class="movie-list">
                <img src="assets/section 3.1.png" alt="Sci-fi show">
                <img src="assets/section 3.2.png" alt="Sci-fi show">
                <img src="assets/section 3.3.png" alt="Sci-fi show">
                <img src="assets/section 3.4.png" alt="Sci-fi show">
                <img src="assets/section 3.5.png" alt="Sci-fi show">
            </div>
        </section>
        <footer>
            <div class="social-icons">
                <img src="assets/facebook.png" alt="Facebook">
                <img src="assets/instagram.png" alt="Instagram">
                <img src="assets/twitter.png" alt="Twitter">
                <img src="assets/youtube.png" alt="Youtube">
            </div>
            <div class="footer-links">
                <div>
                    <p>Seslendirme ve Alt Yazı</p>
                    <p>Medya Merkezi</p>
                    <p>Gizlilik</p>
                    <p>Bize Ulaşın</p>
                </div>
                <div>
                    <p>Sesli Betimleme</p>
                    <p>Yatırımcı İlişkileri</p>
                    <p>Yasal Hükümler</p>
                </div>
                <div>
                    <p>Yardım Merkezi</p>
                    <p>İş imkanları</p>
                    <p>Çerez Tercihleri</p>
                </div>
                <div>
                    <p>Hediye Kartları</p>
                    <p>Kullanım Koşulları</p>
                    <p>Kurumsal Bilgiler</p>
                </div>
            </div>
            <button class="service-button">Hizmet Kodu</button>
            <p class="copyright">
                © 1997-2021 Netflix, Inc.
            </p>
        </footer>
    </main>
</body>
</html>
