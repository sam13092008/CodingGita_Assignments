<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <style>
    body{
    font-family: arial;
}
nav{
    background-color: #121921;
    display: flex;
    padding: 10px;
    margin: 0px;
    color: rgb(249, 247, 247);
    background-color: black;
    align-items: center;
    justify-content: space-between;
    width: 137.72vw;
}
.location{
    display: flex;
}
.img1{
    height: 20px;
    padding-top: 15px;

}
.search{
    display: flex;
    align-items: center;
    height: 50px;
    width: 55%;
}
.all{
    border: .5px solid rgb(142, 141, 141);
    padding: 7px;
    background-color: white;
    color: black;
}
.ser{
    border: 1px solid white;
    
}
.img2{
    color: white;
    background-color: #FBBE67;
    padding: 5.5px;
    border: .5px solid gray;
}
.input1{
    height: 31px;
    width: 100%;
}
.main{
   font-weight: bold;
   border: 1px solid black;
   display: flex;
   background-color: #243040;
   color: white;
   justify-content: space-between;
   width: 139.2vw;
   

}
.option{
    display: flex;
    background-color: #243040;
    gap: 15px;
    align-items: center;
    margin: 10px;
}
.right{
    display: flex;
    width: 380px;
    gap: 20px;

}
.middle{
    display: flex;
    flex-direction: column;
    font-size: 25px;
}
.img3{
    width: 60px;
    justify-self: center;
}
.name{
    font-size: 16px;
    margin-left: 20px;
}
.img4{
    padding: 5px;
}
.mainbody{
    background-image: url(image.png);
    background-repeat: no-repeat;
    width: 200vw;
    height: fit-content;
}
.side{
    display: flex;
    justify-content: space-between;
    height: 300px;
    align-items: center;
    padding: 10px;

}
.center{
    display: flex;
}
.card{
    background-color: white;
    display: flex;
    flex-direction: column;
    width: 370px;
    padding: 20px;
    margin: 15px;
}
.text{
    font-size: 25px;
    color: black;
    font-weight: 700;
    
}
.img6{
    display: grid;
    grid-template-columns: 1fr 1fr ;
    color: gray;
    row-gap: 15px;
    font-size: 12px;
    margin-top: 10px;
}
button{
    color: rgb(0, 119, 255);
    padding: 10px;
    background-color: white;
    border: none;
    margin-top: 5px;
}
.img7{
    margin-top: 10px;
    height: 310px;
}
.btn{
    background-color: #FED813;
    color: black;
    padding: 10px;
    border-radius: 10px;
   
}
.card-1{
     background-color: white;
    display: flex;
    flex-direction: column;
    width: 370px;
    padding: 20px;
    margin: 15px;
    height: 100px;
}
.img8{
    margin-left: 45px;
}
  </style>
</head>

<body>
  <nav>
    <div class="logo"><img src="https://github.com/codinggita/CGxSU_Semester_1/blob/main/Semester_1/html_css_js(sem_01)/CSS/00.assignment/02.level_2/09.amazon-clone/assets/logo.png?raw=true" alt=""></div>
    <div class="location">
      <img class="img1" src="https://github.com/codinggita/CGxSU_Semester_1/blob/main/Semester_1/html_css_js(sem_01)/CSS/00.assignment/02.level_2/09.amazon-clone/assets/location.png?raw=true" alt="">
      <span>Hello<br>
        Select your address</span>
    </div>
    <div class="search">
      <span class="all">All</span><input class="input1" type="text"><img class="img2" src="" alt="">
    </div>
    <div class="country"><img src="https://github.com/codinggita/CGxSU_Semester_1/blob/main/Semester_1/html_css_js(sem_01)/CSS/00.assignment/02.level_2/09.amazon-clone/assets/indian%20flag.png?raw=true" alt=""></div>
    <div><img src="https://github.com/codinggita/CGxSU_Semester_1/blob/main/Semester_1/html_css_js(sem_01)/CSS/00.assignment/02.level_2/09.amazon-clone/assets/down%20arrow.png?raw=true" alt=""></div>
    <div class="account">
      <span class="">Hello,Sign in <br>
            Account & Lists</span>
    </div>
    <div class="order">
      <span>
        Returns <br>
        & Order 
      </span>
    </div>
    <div class="cart">
      <img src="https://github.com/codinggita/CGxSU_Semester_1/blob/main/Semester_1/html_css_js(sem_01)/CSS/00.assignment/02.level_2/09.amazon-clone/assets/cart%20icon.png?raw=true" alt=""><span>Cart</span>
    </div>
  </nav>
  <div class="main">
    <div class="option">
      <div><img src="https://github.com/codinggita/CGxSU_Semester_1/blob/main/Semester_1/html_css_js(sem_01)/CSS/00.assignment/02.level_2/09.amazon-clone/assets/ham%20burger%20icon.png?raw=true" alt=""></div>  
      <div><img src="" alt=""> All</div>
    <div>Best Sellers</div>
    <div>Moblies</div>
    <div>Customers Service</div>
    <div>Today's Deals</div>
    <div>Fashion</div>
    <div>Electronics</div>
    <div>Books</div>
    <div>Prime <img src="image/down arrow.png" alt=""></div>
    <div>New Release</div>
    <div>Home & Kitchen</div>
      <div>Amazon Pay</div>
    </div>
    <div class="right">
      <img src="https://github.com/codinggita/CGxSU_Semester_1/blob/main/Semester_1/html_css_js(sem_01)/CSS/00.assignment/02.level_2/09.amazon-clone/assets/lion.png?raw=true" alt="">
      <div class="middle">prime day <span class="name"> <img class="img3" src="image/amazon design.png" alt="">23<sup>rd</sup>- 24<sup>th</sup> </span></div>
      <img class="img4" src="https://github.com/codinggita/CGxSU_Semester_1/blob/main/Semester_1/html_css_js(sem_01)/CSS/00.assignment/02.level_2/09.amazon-clone/assets/right%20arrow.png?raw=true" alt="">
    </div>
  </div>
  <div class="mainbody">
    <div class="side">
      <img src="https://github.com/codinggita/CGxSU_Semester_1/blob/main/Semester_1/html_css_js(sem_01)/CSS/00.assignment/02.level_2/09.amazon-clone/assets/left%20arrow.png?raw=true" alt="">
      <img src="https://github.com/codinggita/CGxSU_Semester_1/blob/main/Semester_1/html_css_js(sem_01)/CSS/00.assignment/02.level_2/09.amazon-clone/assets/right%20arrow.png?raw=true" alt="">
    </div>
    <div class="center">
      <div class="card">
        <span class="text">Upgrade your home | Amazon Brands & more</span>
        <div class="img6">
          <div><img src="https://github.com/codinggita/CGxSU_Semester_1/blob/main/Semester_1/html_css_js(sem_01)/CSS/00.assignment/02.level_2/09.amazon-clone/assets/image%2017.png?raw=true" alt="">Smart LED TVs</div>
          <div><img src="https://github.com/codinggita/CGxSU_Semester_1/blob/main/Semester_1/html_css_js(sem_01)/CSS/00.assignment/02.level_2/09.amazon-clone/assets/image%2018.png?raw=true" alt="">Appliances</div>
          <div><img src="https://github.com/codinggita/CGxSU_Semester_1/blob/main/Semester_1/html_css_js(sem_01)/CSS/00.assignment/02.level_2/09.amazon-clone/assets/image%2020.png?raw=true" alt="">Furniture</div>
          <div><img src="https://github.com/codinggita/CGxSU_Semester_1/blob/main/Semester_1/html_css_js(sem_01)/CSS/00.assignment/02.level_2/09.amazon-clone/assets/image%2019.png?raw=true" alt="">kitchen product</div>
        </div>
        <button>Shop now</button>
      </div>
      <div class="card">
        <span class="text">Revamp your home in style </span>
        <div class="img6">
          <div><img src="https://github.com/codinggita/CGxSU_Semester_1/blob/main/Semester_1/html_css_js(sem_01)/CSS/00.assignment/02.level_2/09.amazon-clone/assets/image%2025.png?raw=true" alt="">Bedsheets, curtains & more</div>
          <div><img src="https://github.com/codinggita/CGxSU_Semester_1/blob/main/Semester_1/html_css_js(sem_01)/CSS/00.assignment/02.level_2/09.amazon-clone/assets/image%2022.png?raw=true" alt="">Home Storage</div>
          <div><img src="https://github.com/codinggita/CGxSU_Semester_1/blob/main/Semester_1/html_css_js(sem_01)/CSS/00.assignment/02.level_2/09.amazon-clone/assets/image%2021.png?raw=true" alt="">Lighting Solution</div>
          <div><img src="https://github.com/codinggita/CGxSU_Semester_1/blob/main/Semester_1/html_css_js(sem_01)/CSS/00.assignment/02.level_2/09.amazon-clone/assets/image%2024.png?raw=true" alt="">Home decoration</div>
        </div>
        <button>Explore all</button>
      </div>
      <div class="card">
        <span class="text">Up to 70% off | Clearance store</span>
        <img class="img7" src="https://github.com/codinggita/CGxSU_Semester_1/blob/main/Semester_1/html_css_js(sem_01)/CSS/00.assignment/02.level_2/09.amazon-clone/assets/image%2026.png?raw=true" alt="">
        <button>See More</button>
      </div>
      <div class="bottom">
      <div class="card-1">
        <span class="text">Sign in for your best experience</span>
        <button class="btn">Sign in Securely</button>
      </div>
      <img class="img8" src="https://github.com/codinggita/CGxSU_Semester_1/blob/main/Semester_1/html_css_js(sem_01)/CSS/00.assignment/02.level_2/09.amazon-clone/assets/image%2028.png?raw=true" alt="">
      </div>
    </div>
  </div>
</body>

</html>
